{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/check_agent_sync.py\" --hook",
            "timeout": 15,
            "statusMessage": "Checking Claude/Codex sync"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/check_agent_sync.py\" --hook",
            "timeout": 15,
            "statusMessage": "Checking Claude/Codex sync"
          }
        ]
      }
    ]
  }
}
